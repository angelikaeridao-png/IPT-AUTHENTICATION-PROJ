<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_schedule_card"
    android:orientation="vertical"
    android:padding="14dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/vTimeBar"
            android:layout_width="32dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_accent_bar" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:alpha="0.2"
            android:contentDescription="@null"
            android:src="@drawable/ic_hashtag_small"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvScheduleTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="8:00 – 8:45 AM" />

    <TextView
        android:id="@+id/tvScheduleSubject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Calculus I" />

    <TextView
        android:id="@+id/tvScheduleRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="Room 204 · Mr. Alcaraz" />

</LinearLayout>
